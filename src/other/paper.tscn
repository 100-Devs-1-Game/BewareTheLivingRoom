[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_at1jb"]
bg_color = Color(0, 0, 0, 0.27451)

[sub_resource type="Shader" id="Shader_y8b02"]
code = "shader_type canvas_item;

uniform vec3 paper_color = vec3(0.95, 0.92, 0.85);
uniform float noise_scale = 50.0;
uniform float noise_strength = 0.05;
uniform float edge_darkness = 0.1;

// Simple hash-based noise
float hash(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}

float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);

    float a = hash(i);
    float b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0));
    float d = hash(i + vec2(1.0, 1.0));

    vec2 u = f*f*(3.0-2.0*f);

    return mix(a, b, u.x) + (c - a)*u.y*(1.0 - u.x) + (d - b)*u.x*u.y;
}

void fragment() {
    vec2 uv = UV * noise_scale;

    // Base paper color
    vec3 color = paper_color;

    // Add texture noise
    color += vec3(noise(uv)) * noise_strength;

    // Edge vignette
    float dist = distance(UV, vec2(0.5));
    color *= 1.0 - smoothstep(0.45, 0.5, dist) * edge_darkness;

    COLOR = vec4(color, 1.0);
}
"

